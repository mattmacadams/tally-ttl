{
	"compilerOptions": {
		"strict": true,
		"target": "es6",
		"module": "esnext",
		"moduleResolution": "classic",
		"moduleDetection": "auto",
		"declaration": true,
		"removeComments": true,
		"lib": ["es6", "dom"],
		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
