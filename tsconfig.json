{
	"compilerOptions": {
		"target": "es2020",
		"module": "es2020",
		"moduleResolution": "node",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"declaration": true,
		"outDir": "dist/esm",
		"rootDir": "src",
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
